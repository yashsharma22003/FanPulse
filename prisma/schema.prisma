generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  UP
  DOWN
}

enum PredictionStatus {
  PENDING
  OPEN
  LOCKED
  EXPIRED
}

enum ChallengeStatus {
  LOCKED
  RESOLVED
  VOIDED
  EXPIRED
}

enum BattleStatus {
  OPEN
  LOCKED
  RESOLVED
  VOIDED
}

enum AiStatus {
  IDLE
  PENDING
  READY
  FAILED
}

model User {
  id              String   @id @default(cuid())
  wallet          String   @unique
  challengeEnergy Decimal  @default(0) @db.Decimal(18, 8)
  challengeRating Int      @default(1000)
  wins            Int      @default(0)
  losses          Int      @default(0)
  fanNftTier         Int?     // last on-chain tier 0-4; null = never minted
  fanNftTokenId      Int?
  fanNftTxHash       String?
  fanNftSyncPending  Boolean  @default(false)
  battlesWon         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  predictions        Prediction[]
  challengesWon      Challenge[]         @relation("ChallengeWinner")
  ratingEvents       RatingEvent[]
  battleEntries      BattleEntry[]
  battleRatingEvents BattleRatingEvent[]
}

model Market {
  id            String   @id @default(cuid())
  marketId      String   @unique
  asset         String
  intervalSec   Int
  tradingStart  DateTime?
  expiry        DateTime
  pool          String?
  venueId       String?
  upSymbol      String?
  downSymbol    String?
  onchainStatus Int      @default(1)
  aiProbability Int?
  aiRequestId   String?
  aiStatus      AiStatus @default(IDLE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  predictions Prediction[]
  battle      Battle?
}

model Prediction {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  marketRowId        String
  market             Market           @relation(fields: [marketRowId], references: [id])
  direction          Direction
  confidence         Decimal          @db.Decimal(5, 4)
  quantity           Decimal          @db.Decimal(28, 8)
  quantityFilled     Decimal          @default(0) @db.Decimal(28, 8)
  orderId            String?
  txHash             String?
  yesId              String?
  noId               String?
  status             PredictionStatus @default(PENDING)
  challengeExpiresAt DateTime?
  challengingOfId    String?
  battleId           String?
  challengingOf      Prediction?      @relation("ChallengeAttempt", fields: [challengingOfId], references: [id])
  challengeAttempts  Prediction[]     @relation("ChallengeAttempt")
  battle             Battle?          @relation("BattlePredictions", fields: [battleId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  originalChallenge    Challenge? @relation("OriginalPrediction")
  challengerChallenge  Challenge? @relation("ChallengerPrediction")
  battleEntry          BattleEntry?

  @@index([status, challengeExpiresAt])
  @@index([marketRowId, status])
}

model Challenge {
  id                     String          @id @default(cuid())
  originalPredictionId   String          @unique
  originalPrediction     Prediction      @relation("OriginalPrediction", fields: [originalPredictionId], references: [id])
  challengerPredictionId String          @unique
  challengerPrediction   Prediction      @relation("ChallengerPrediction", fields: [challengerPredictionId], references: [id])
  status                 ChallengeStatus @default(LOCKED)
  winnerUserId           String?
  winner                 User?           @relation("ChallengeWinner", fields: [winnerUserId], references: [id])
  multiplier             Decimal         @default(1) @db.Decimal(8, 4)
  energyPaid             Decimal         @default(0) @db.Decimal(18, 8)
  resolvedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  ratingEvents RatingEvent[]

  @@index([status])
}

model RatingEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id])
  input        Json
  ratingBefore Int
  ratingAfter  Int
  createdAt    DateTime @default(now())
}

model AuthNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model Battle {
  id               String        @id @default(cuid())
  marketRowId      String        @unique
  market           Market        @relation(fields: [marketRowId], references: [id])
  status           BattleStatus  @default(OPEN)
  locksAt          DateTime
  winningDirection Direction?
  voidReason       String?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  entries            BattleEntry[]
  ratingEvents       BattleRatingEvent[]
  pendingPredictions Prediction[]      @relation("BattlePredictions")

  @@index([status])
  @@index([locksAt])
}

model BattleEntry {
  id           String     @id @default(cuid())
  battleId     String
  battle       Battle     @relation(fields: [battleId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  predictionId String     @unique
  prediction   Prediction @relation(fields: [predictionId], references: [id])
  placement    Int?
  energyPaid   Decimal    @default(0) @db.Decimal(18, 8)
  multiplier   Decimal    @default(1) @db.Decimal(8, 4)
  createdAt    DateTime   @default(now())

  @@unique([battleId, userId])
  @@index([battleId])
}

model BattleRatingEvent {
  id           String   @id @default(cuid())
  battleId     String
  battle       Battle   @relation(fields: [battleId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  ratingBefore Int
  ratingAfter  Int
  input        Json
  createdAt    DateTime @default(now())

  @@index([battleId])
  @@index([userId])
}
